---
import { Image } from "astro:assets";

interface Button {
  label?: string;
  id?: number;
  icon?: string;
  classes?: string;
}



const { label, id, icon, classes } = Astro.props;

console.log(icon)
---

<button id={id} class={classes}>
  <figure class="btn-content">
    <Image
      src={icon}
      alt=""
      width={icon.width}
      height={icon.height}
      class="btn-img"
    />
  </figure>
  <span class="btn-label">
    {label}
  </span>
</button>
